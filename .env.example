# ====================================================================
# Swaati Enterprises SEMS - Production Backend Environment Template
# ====================================================================

PORT=4000
NODE_ENV=production

# 1. Database Connection (Neon PostgreSQL)
# Required format: postgresql://<user>:<password>@<neon-host>/<db>?sslmode=require
DATABASE_URL=postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# 2. JWT Authentication Secrets
# Generate a strong 64-byte random string for production
JWT_SECRET=your_production_jwt_secret_minimum_32_characters
JWT_EXPIRES_IN=7d

# 3. Production Frontend & CRM URLs for Strict CORS
FRONTEND_URL=https://swaatienterprises.in
CRM_URL=https://app.swaatienterprises.in
CORS_ORIGINS=https://swaatienterprises.in,https://www.swaatienterprises.in,https://app.swaatienterprises.in

# 4. Cloudflare R2 Object Storage (Private Bucket: appswaatienterprises)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=appswaatienterprises
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com

